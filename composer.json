{
    "name": "hbp/settings-ui",
    "description": "Admin field and settings-page layer for hbp/settings.",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "keywords": [
        "wordpress"
    ],
    "authors": [
        {
            "name": "Hybopress Themes",
            "email": "hybopressthemes@gmail.com",
            "homepage": "https://hybopressthemes.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/hybopress/settings-ui",
    "support": {
        "issues": "https://github.com/hybopress/settings-ui/issues"
    },
    "require": {
        "php": ">=8.2",
        "hbp/settings": "^1.0.0-alpha.1",
        "themehybrid/hybrid-contracts": "^2.0",
        "themehybrid/hybrid-core": "^7.0",
        "themehybrid/hybrid-tools": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hybopress/settings"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HBP\\Settings\\Ui\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "hybrid-core": {
            "providers": [
                "HBP\\Settings\\Ui\\Providers\\SettingsUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@composer --working-dir=qa test"
    }
}
